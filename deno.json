{
	"tasks": {
		"add": {
			"command": "grep -qxF \"add_subdirectory($INIT_CWD)\" CMakeLists.txt || echo \"add_subdirectory($INIT_CWD)\" >> CMakeLists.txt",
			"description": "add a project"
		},
		"lldb": {
			"command": "cmake --build .build -t \"$(perl -ne 'print \"$1.lldb\" if /(?:add_solution|solve)\\(([^\\s\\)]*)/' \"$INIT_CWD/CMakeLists.txt\")\"",
			"description": "attach lldb"
		},
		"test": {
			"command": "cmake --build .build -t \"$(perl -ne 'print \"$1.test\" if /(?:add_solution|solve)\\(([^\\s\\)]*)/' \"$INIT_CWD/CMakeLists.txt\")\"",
			"description": "run tests"
		},
		"cmake": {
			"command": "cmake -G Ninja -B .build",
			"description": "re-run configure (should never have to do this)"
		}
	}
}
